{
  "name": "partner-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Daily shortlist of YouTube creators worth a personal partnership message, with drafts for a human to approve.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
